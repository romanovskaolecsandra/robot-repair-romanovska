    - visitorName: "\u0422\u0430\u0440\u0430\u0441 \u0411\u043E\u043D\u0434\u0430\u0440"
      documentDetails: "\u041F\u0415\u0420\u0415\u041F\u0423\u0421\u0422\u041A\u0410
        #114\r\n\u0406\u043C'\u044F: \u0422\u0430\u0440\u0430\u0441 \u0411\u043E\u043D\u0434\u0430\u0440\r\n\u0421\u0435\u043A\u0442\u043E\u0440:
        \u0410-1\r\n\u0420\u0456\u043A \u0432\u0438\u0434\u0430\u0447\u0456: 2082\r\n"
      healthCertDetails: "\u041C\u0415\u0414\u0414\u041E\u0412\u0406\u0414\u041A\u0410
        #114\r\n\u041F\u0430\u0446\u0456\u0454\u043D\u0442: \u0422\u0430\u0440\u0430\u0441
        \u0411\u043E\u043D\u0434\u0430\u0440\r\n\u0420\u0430\u0434\u0456\u0430\u0446\u0456\u044F:
        \u041D\u043E\u0440\u043C\u0430\r\n\u0421\u0442\u0430\u0442\u0443\u0441: \u0417\u0414\u041E\u0420\u041E\u0412\u0418\u0419\r\n"
      dialogueLine: "\u0414\u043E\u0432\u0456\u0434\u043A\u0430 \u0441\u0432\u0456\u0436\u0430,
        \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0440\u043E\u0431\u0438\u0432!
        \u0410 \u043F\u0435\u0440\u0435\u043F\u0443\u0441\u0442\u043A\u0443 \u043F\u0440\u043E\u0441\u0442\u043E
        \u043D\u0435 \u0432\u0441\u0442\u0438\u0433 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438."
