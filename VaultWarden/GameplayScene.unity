  m_Script: {fileID: 11500000, guid: 97838aa7fa841d347b04deca9bc38c95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  dialogueText: {fileID: 372132924}
  docDetailsText: {fileID: 1097401572}
  avatarImage: {fileID: 2131470207}
  livesText: {fileID: 960646838}
  scoreText: {fileID: 1985768315}
  endGamePanel: {fileID: 1393223137}
  endTitleText: {fileID: 517359363}
  endStatsText: {fileID: 961206281}
  visitorsList:
  - visitorName: "\u0414\u0436\u043E\u043D \u0414\u043E\u0443"
    documentDetails: "\u041F\u0415\u0420\u0415\u041F\u0423\u0421\u0422\u041A\u0410
      #682\n\u0406\u043C'\u044F: \u0414\u0436\u043E\u043D \u0414\u043E\u0443\n\u0414\u043E\u0441\u0442\u0443\u043F:
      \u0414\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u043E\n\u0414\u0456\u0439\u0441\u043D\u0438\u0439
      \u0434\u043E: 2026"
    dialogueLine: "\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0432\u043F\u0443\u0441\u0442\u0456\u0442\u044C
      \u043C\u0435\u043D\u0435! \u0417\u0430 \u043C\u043D\u043E\u044E \u0433\u043E\u043D\u044F\u0442\u044C\u0441\u044F
      \u043C\u0430\u0440\u043E\u0434\u0435\u0440\u0438!"
    avatarSprite: {fileID: 0}
    isSpyOrIdiot: 0
  - visitorName: "\u041E\u043B\u0435\u043D\u0430 \u041A\u043E\u0432\u0430\u043B\u044C"
    documentDetails: "\u041F\u0415\u0420\u0415\u041F\u0423\u0421\u0422\u041A\u0410
      #104\n\u0406\u043C'\u044F: \u041E\u043B\u0435\u043D\u0430 \u041A\u043E\u0432\u0430\u043B\u044C\n\u0414\u043E\u0441\u0442\u0443\u043F:
      \u0414\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u043E\n\u0414\u0456\u0439\u0441\u043D\u0438\u0439
      \u0434\u043E: 2026"
    dialogueLine: "\u042F \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0430
      \u0432 \u0442\u0435\u043F\u043B\u0438\u0446\u044F\u0445 \u043D\u0430 \u043E\u043A\u043E\u043B\u0438\u0446\u0456,
      \u043C\u0456\u0439 \u0442\u0435\u0440\u043C\u043E\u043A\u043E\u0441\u0442\u044E\u043C
      \u043C\u0430\u0439\u0436\u0435 \u0440\u043E\u0437\u0440\u044F\u0434\u0438\u0432\u0441\u044F.
      \u0411\u043B\u0430\u0433\u0430\u044E, \u043F\u0443\u0441\u0442\u0456\u0442\u044C
      \u0433\u0440\u0456\u0442\u0438\u0441\u044F."
    avatarSprite: {fileID: 0}
    isSpyOrIdiot: 0
  - visitorName: "\u041D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0439 \u0448\u043F\u0438\u0433\u0443\u043D"
    documentDetails: "\u041F\u0415\u0420\u0415\u041F\u0423\u0421\u0422\u041A\u0410
      #777\n\u0406\u043C'\u044F: \u0410\u043B\u0435\u043A\u0441 \u0421\u043C\u0456\u0442\n\u0414\u043E\u0441\u0442\u0443\u043F:
      \u0414\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u043E\n\u0414\u0456\u0439\u0441\u043D\u0438\u0439
      \u0434\u043E: 2026"
    dialogueLine: "\u041F\u0440\u0438\u0432\u0456\u0442, \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435!
      \u042F \u0437\u0430 \u043B\u0456\u043A\u0430\u043C\u0438 \u0434\u043B\u044F
      \u0441\u0432\u043E\u0454\u0457 \u0434\u0438\u0442\u0438\u043D\u0438. \u041E\u0441\u044C
      \u043C\u0456\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442, \u043C\u0435\u043D\u0435
      \u0437\u0432\u0443\u0442\u044C \u041C\u0430\u043A\u0441."
    avatarSprite: {fileID: 0}
    isSpyOrIdiot: 1
  - visitorName: "\u0417\u0430\u0431\u0443\u0434\u044C\u043A\u0443\u0432\u0430\u0442\u0438\u0439
      \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u043A"
    documentDetails: "\u041F\u0415\u0420\u0415\u041F\u0423\u0421\u0422\u041A\u0410
      #341\n\u0406\u043C'\u044F: \u041C\u0430\u0440\u043A \u0410\u0432\u0440\u0435\u043B\u0456\u0439\n\u0414\u043E\u0441\u0442\u0443\u043F:
      \u0414\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u043E\n\u0414\u0456\u0439\u0441\u043D\u0438\u0439
      \u0434\u043E: 2024"
    dialogueLine: "\u0424\u0443\u0445, \u043B\u0435\u0434\u0432\u0435 \u0434\u0456\u0439\u0448\u043E\u0432
      \u0434\u043E \u0432\u0430\u0448\u043E\u0457 \u0431\u0440\u0430\u043C\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0431\u0443\u0440\u044E. \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435
      \u043C\u043E\u0457 \u043F\u0430\u043F\u0435\u0440\u0438, \u0442\u0430\u043C
      \u0443\u0441\u0435 \u0447\u0438\u0441\u0442\u043E."
    avatarSprite: {fileID: 0}
    isSpyOrIdiot: 1
  - visitorName: "\u0420\u0430\u0434\u0456\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0439
      \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442"
    documentDetails: "\u041F\u0415\u0420\u0415\u041F\u0423\u0421\u0422\u041A\u0410
      #009\n\u0406\u043C'\u044F: \u0412\u0456\u043A\u0442\u043E\u0440 \u0420\u0435\u0437\u043D\u043E\u0432\n\u0414\u043E\u0441\u0442\u0443\u043F:
      \u0417\u0410\u0411\u041B\u041E\u041A\u041E\u0412\u0410\u041D\u041E\n\u0414\u0456\u0439\u0441\u043D\u0438\u0439
      \u0434\u043E: 2026"
    dialogueLine: "\u0412\u0456\u0434\u0447\u0438\u043D\u044F\u0439 \u0431\u0440\u0430\u043C\u0443,
      \u0441\u0442\u0430\u0436\u0435\u0440! \u0423 \u043C\u0435\u043D\u0435 \u0442\u0435\u0440\u043C\u0456\u043D\u043E\u0432\u0435
      \u0434\u043E\u043D\u0435\u0441\u0435\u043D\u043D\u044F \u0434\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430
      \u0431\u0443\u043D\u043A\u0435\u0440\u0430. \u041D\u0435 \u0437\u043C\u0443\u0448\u0443\u0439
      \u043C\u0435\u043D\u0435 \u0447\u0435\u043A\u0430\u0442\u0438."
    avatarSprite: {fileID: 0}
    isSpyOrIdiot: 1
